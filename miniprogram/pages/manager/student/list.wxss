.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  display: flex;
  padding: 20rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 120rpx !important;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  background: #1AAD19;
  color: #fff;
}

.toolbar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}

.tool-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border: 1rpx solid #ddd;
  background: #fff;
  border-radius: 12rpx;
}

.tool-btn.primary {
  background: #1AAD19;
  color: #fff;
  border-color: #1AAD19;
}

.list-wrap {
  padding: 0 24rpx 24rpx;
}

.student-item {
  margin-bottom: 16rpx;
}

.student-item:active {
  background: #f9f9f9;
}

.student-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.student-id {
  font-size: 26rpx;
  color: #999;
}

.student-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.student-phone,
.student-dorm {
  font-size: 26rpx;
  color: #666;
}

.student-footer {
  display: flex;
  justify-content: flex-end;
}

.student-auth {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #e8f5e9;
  color: #4caf50;
}

.student-auth.no {
  background: #fff3e0;
  color: #ff9800;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more,
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #999;
}
