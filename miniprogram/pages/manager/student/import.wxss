.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.guide-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.guide-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.guide-cols {
  font-size: 26rpx;
  color: #1AAD19;
  font-weight: 600;
  display: block;
  padding: 8rpx 0 8rpx 16rpx;
  border-left: 4rpx solid #1AAD19;
  margin: 12rpx 0;
}

.upload-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.file-picker {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.file-picker:active {
  background: #f9f9f9;
}

.picker-icon {
  font-size: 64rpx;
  color: #ccc;
  line-height: 1;
}

.picker-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.file-info {
  margin-top: 24rpx;
  text-align: center;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.file-size {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.action-wrap {
  margin-bottom: 24rpx;
}

.import-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1AAD19;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

.import-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.result-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.result-row.success .result-value {
  color: #4caf50;
}

.result-row.fail .result-value {
  color: #f44336;
}

.error-list {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.error-title {
  font-size: 26rpx;
  color: #f44336;
  margin-bottom: 8rpx;
  display: block;
}

.error-item {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 0;
  line-height: 1.6;
}
