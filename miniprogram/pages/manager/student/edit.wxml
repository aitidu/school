<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        placeholder="请输入学生姓名"
        value="{{realName}}"
        bindinput="onNameInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">学号</text>
      <input
        class="form-input"
        placeholder="请输入学号"
        value="{{studentId}}"
        bindinput="onIdInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">宿舍楼栋</text>
      <input
        class="form-input"
        placeholder="如：1号楼A栋101"
        value="{{dormitory}}"
        bindinput="onDormInput"
      />
    </view>
  </view>

  <view class="save-btn-wrap">
    <button class="save-btn" bindtap="save" loading="{{loading}}" disabled="{{loading}}">
      {{isEdit ? '保存修改' : '添加学生'}}
    </button>
  </view>
</view>
