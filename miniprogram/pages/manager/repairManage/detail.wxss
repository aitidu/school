.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-type {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
}

.status-pending { background: #ff9800; }
.status-assigned { background: #2196f3; }
.status-in_progress { background: #4caf50; }
.status-completed { background: #9e9e9e; }
.status-archived { background: #616161; }

.detail-desc {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
}

.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.detail-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 8rpx;
}

.detail-meta {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.detail-time,
.detail-worker {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.stars {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
}

.star.active {
  color: #ffb300;
}

.eval-comment {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.eval-comment.empty {
  color: #ccc;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.action-btn.primary {
  background: #1AAD19;
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #1AAD19;
  border: 1rpx solid #1AAD19;
}

/* 派单弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.assign-dialog {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  z-index: 101;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.worker-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.dialog-btns {
  display: flex;
  gap: 24rpx;
}

.dialog-btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background: #1AAD19;
  color: #fff;
}
