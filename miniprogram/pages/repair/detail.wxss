.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-type {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
}

.status-pending { background: #ff9800; }
.status-assigned { background: #2196f3; }
.status-in_progress { background: #4caf50; }
.status-completed { background: #9e9e9e; }
.status-archived { background: #616161; }

.detail-desc {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
}

.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.detail-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 8rpx;
}

.detail-meta {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.detail-time,
.detail-worker {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.actions {
  margin-top: 32rpx;
}

.action-btn {
  width: 100%;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.action-btn.primary {
  background: #1AAD19;
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #1AAD19;
  border: 1rpx solid #1AAD19;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.eval-form {
  margin-top: 32rpx;
}

.stars {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  transition: color 0.2s;
}

.star.active {
  color: #ffb300;
}

.comment-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.eval-btns {
  display: flex;
  gap: 24rpx;
}

.eval-btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.eval-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.eval-btn.confirm {
  background: #1AAD19;
  color: #fff;
}

.eval-result {
  margin-top: 32rpx;
}

.eval-comment {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.eval-comment.empty {
  color: #ccc;
}
