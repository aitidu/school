.auth-tip {
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.tip-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.form-card {
  padding: 0;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.submit-btn {
  margin: 48rpx 20rpx;
  background-color: #1AAD19;
  border-radius: 12rpx;
}
