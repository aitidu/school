<view class="container">
  <!-- 用户信息卡片 -->
  <view class="card user-card">
    <view class="avatar-wrap">
      <open-data type="userAvatarUrl" class="avatar" wx:if="{{user}}"></open-data>
      <view class="avatar placeholder" wx:else></view>
    </view>
    <view class="user-info" wx:if="{{user}}">
      <text class="nickname">
        <open-data type="userNickName"></open-data>
      </text>
      <view class="auth-badge {{user.isAuth ? 'authed' : ''}}">
        <text>{{user.isAuth ? '已认证' : '未认证'}}</text>
      </view>
    </view>
    <view class="user-info" wx:else>
      <text class="nickname">未登录</text>
    </view>
  </view>

  <!-- 详细资料 -->
  <view class="card info-card" wx:if="{{user}}">
    <view class="info-item">
      <text class="label">姓名</text>
      <text class="value">{{user.realName || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="label">学号</text>
      <text class="value">{{user.studentId || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="label">手机号</text>
      <text class="value">{{user.phone || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="label">宿舍</text>
      <text class="value">{{user.dormitory || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="label">身份</text>
      <text class="value">{{user.role === 'manager' ? '管理员' : '学生'}}</text>
    </view>
  </view>

  <!-- 操作入口 -->
  <view class="actions" wx:if="{{user}}">
    <view class="card action-item" bindtap="goToMyRepairs">
      <text class="action-icon">&#xe623;</text>
      <text class="action-text">我的报修</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToLateReport">
      <text class="action-icon">&#xe64d;</text>
      <text class="action-text">晚归报备</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToLeaveRequest">
      <text class="action-icon">&#xe646;</text>
      <text class="action-text">请假申请</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToMyAttendance">
      <text class="action-icon">&#xe649;</text>
      <text class="action-text">归寝记录</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToRepairManage" wx:if="{{user.role === 'manager'}}">
      <text class="action-icon">&#xe60f;</text>
      <text class="action-text">报修管理</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToAuth" wx:if="{{!user.isAuth}}">
      <text class="action-icon">&#xe642;</text>
      <text class="action-text">实名认证</text>
      <text class="action-arrow">></text>
    </view>
    <view class="card action-item" bindtap="goToEditProfile">
      <text class="action-icon">&#xe63d;</text>
      <text class="action-text">修改资料</text>
      <text class="action-arrow">></text>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="card login-tip" wx:else>
    <text>正在获取用户信息…</text>
  </view>
</view>
