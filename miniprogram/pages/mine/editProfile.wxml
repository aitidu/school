<view class="container">
  <view class="card form-card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入姓名" value="{{realName}}" data-field="realName" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">学号</text>
      <input class="form-input" placeholder="请输入学号" value="{{studentId}}" data-field="studentId" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" maxlength="11" />
    </view>
    <view class="form-item">
      <text class="form-label">宿舍</text>
      <input class="form-input" placeholder="如：北1-101" value="{{dormitory}}" data-field="dormitory" bindinput="onInput" />
    </view>
  </view>

  <button class="submit-btn" type="primary" bindtap="submit">保存</button>
</view>
