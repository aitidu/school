.user-card {
  display: flex;
  align-items: center;
  padding: 48rpx 24rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar.placeholder {
  background-color: #e0e0e0;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
}

.auth-badge {
  display: inline-block;
  background-color: #ff9800;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.auth-badge.authed {
  background-color: #4caf50;
}

.info-card {
  padding: 8rpx 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  color: #888;
  font-size: 28rpx;
}

.value {
  color: #333;
  font-size: 28rpx;
}

.actions {
  margin-top: 32rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 2rpx;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  color: #1AAD19;
}

.action-text {
  flex: 1;
  font-size: 30rpx;
}

.action-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.login-tip {
  text-align: center;
  padding: 80rpx 24rpx;
  color: #999;
}
